{
    "private": true,
    "name": "mono",
    "version": "1.0.20",
    "scripts": {
        "clean": "git clean -fdX",
        "build": "pnpm -r --filter \"./packages/vorplex/**\" build",
        "test": "pnpm -r --filter \"./packages/vorplex/**\" test",
        "version": "npx tsx .scripts/version.ts",
        "publish": "pnpm build && pnpm --filter \"./packages/vorplex/**\" publish --recursive --access public --no-git-checks",
        "package-list": "npx tsx .scripts/package-list.mts",
        "purge-cdn": "npx tsx .scripts/purge-cdn.mts",
        "serve:drx": "npx tsx packages/vorplex/drx/standalone/serve.mts"
    },
    "devDependencies": {
        "@types/node": "workspace:*",
        "@vorplex/core": "workspace:*",
        "@vorplex/node": "workspace:*",
        "tsx": "workspace:*",
        "typescript": "workspace:*",
        "vitest": "workspace:*",
        "yaml": "workspace:*"
    }
}
